PORT=3000
DB_HOST=localhost
DB_USER=root
DB_PASS=troque_esta_senha
DB_NAME=finance_control

# Gere um segredo forte, ex.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_este_segredo
JWT_EXPIRES_IN=7d

# Diretório onde os comprovantes são gravados
STORAGE_DIR=./storage

# Usuário de demonstração criado por `node seed.js`
SEED_EMAIL=demo@financecontrol.local
SEED_PASSWORD=demo1234
